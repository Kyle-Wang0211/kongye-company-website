{
  "status": "prepared_not_deployed_cloud_access_required",
  "provider": "Alibaba OpenSearch industry algorithm edition",
  "public_projection": "public-work-projection.sql",
  "fields": {
    "id": {"source": "works.id", "type": "LITERAL", "primary_key": true},
    "title": {"source": "works.title", "type": "TEXT"},
    "description": {"source": "works.description", "type": "TEXT"}
  },
  "text_index": {"name": "default", "fields": ["title", "description"], "analyzer": "existing_official_Chinese_analyzer_no_custom_rank"},
  "suggestion": {
    "source_field": "title",
    "generation": "original_value_retention",
    "extraction_model": null,
    "query_history_source": "disabled",
    "endpoint": "/v3/openapi/suggestions/{OPENSEARCH_SUGGESTER}/actions/search",
    "maximum_query_utf8_bytes": 30,
    "hit": 10,
    "training": "existing ready model required; official documentation describes T+1 updates and dataset completeness thresholds"
  },
  "search": {
    "endpoint": "/v3/openapi/apps/{OPENSEARCH_APP}/search",
    "fetch_fields": "id",
    "query": "config=start:0,hit:20,format:fulljson&&query={OPENSEARCH_INDEX}:'{escaped_literal}'",
    "rank": "existing official application default preserved"
  },
  "server_environment_required": ["OPENSEARCH_ENDPOINT", "OPENSEARCH_APP", "OPENSEARCH_SUGGESTER", "OPENSEARCH_INDEX", "OPENSEARCH_ACCESS_KEY_ID", "OPENSEARCH_ACCESS_KEY_SECRET", "OPENSEARCH_PUBLIC_PROJECTION_VERIFIED"],
  "unresolved": [
    "Actual existing instance/application/index/suggester identity and endpoint",
    "Application edition supports the current suggestion endpoint",
    "Ready trained suggestion model for actual public catalogue",
    "Current cloud access to inspect running service and existing resource capacity",
    "Incremental removal on delete, hide, moderation change, or publication withdrawal",
    "Live suggestion titles revalidated against currently public database rows before response, preserving upstream order",
    "Existing instance billing and current quota verified before enabling requests"
  ],
  "official_sources": [
    "https://help.aliyun.com/zh/open-search/industry-algorithm-edition/drop-down-suggestions",
    "https://help.aliyun.com/zh/open-search/industry-algorithm-edition/initiate-search-requests",
    "https://help.aliyun.com/zh/open-search/high-performance-searchedition/v3-api-signature-mechanism"
  ]
}
